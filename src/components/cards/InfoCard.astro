---
import cards from "../../data/cards.json";
---

<div
  class="p-2 grid grid-cols-1 md:grid-cols-2 gap-6 w-full mt-10"
>
  {
    cards.map((card) => (
      <article class="my-2 group relative">
        <div class="bg-(--line) inset-x-0 absolute w-full h-0.5 rounded-md" />
        <div class="bg-(--secondary) inset-x-0 absolute w-full h-0.5 rounded-md origin-left scale-x-25 group-hover:scale-x-100 transition-all duration-300 ease-in-out" />
        <div class="mt-4">
          <h2 class="font-jakarta text-xl md:text-2xl font-bold text-(--text-primary) mb-2">
            {card.title}
          </h2>
          <p class="text-md text-(--text) max-w-md">{card.description}</p>
        </div>
      </article>
    ))
  }
</div>
