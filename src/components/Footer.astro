  >
    <small class="text-(--text-muted)">
      &copy; {year} Hermanos Mendoza. All rights reserved.
    </small>

    <small class="text-(--text-muted)">
      Designed and developed by <a
        href="https://mariosdev.me/"
        class="text-(--text-primary) underline underline-offset-2 hover:text-(--secondary) transition-all duration-300 ease-in-out"
        >marioswc</a
      >
    </small>
  </div>
</footer>
