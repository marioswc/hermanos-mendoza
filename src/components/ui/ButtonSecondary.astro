---
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a
  href={href}
  class="inline-block text-md font-semibold text-(--primary) px-3 py-2 bg-transparent border border-(--primary) rounded-full hover:border-(--secondary) hover:text-(--secondary) hover:-translate-y-0.5 hover:bg-gray-50 transition-all duration-300 ease-in-out"
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="flex items-center gap-2">
    <slot />
  </span>
</a>
