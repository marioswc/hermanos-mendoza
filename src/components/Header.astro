---
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import ButtonPrimary from "./ui/ButtonPrimary.astro";
---

<header
  class="fixed left-0 right-0 z-50 shadow-xs p-2 border-b border-gray-200 backdrop-blur-sm bg-white/60"
>
  <nav
    aria-label="Navegación principal"
    class="flex items-center justify-between"
  >
    <a
      href="/"
      class="block w-24"
      aria-label="Hermanos Mendoza - Inicio"
    >
      <Image
        src={logo}
        width={96}
        height={96}
        decoding="async"
        alt="Logo de Hermanos Mendoza"
        loading={"eager"}
      />
    </a>

    <div class="flex items-center gap-4 justify-between">
      <!-- Desktop ant Tablet Menu -->
      <ul class="hidden md:flex items-center gap-8">
        <li>
          <a
            href="#proyectos"
            class="text-(--text-secondary) text-sm hover:text-(--secondary) transition-all duration-300 ease-in-out"
            >Proyectos</a
          >
        </li>
        <li>
          <a
            href="#nosotros"
            class="text-(--text-secondary) text-sm hover:text-(--secondary) transition-all duration-300 ease-in-out"
            >Por qué nosotros</a
          >
        </li>
        <li>
          <a
            href="#contacto"
            class="text-(--text-secondary) text-sm hover:text-(--secondary) transition-all duration-300 ease-in-out"
            >Contacto y Preguntas</a
          >
        </li>
      </ul>

      <ButtonPrimary
        href="https://wa.me/520000000000?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20una%20cotizaci%C3%B3n"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 640 640"
          width="24"
          height="24"
        >
          <path
            d="M476.9 161.1c-41.9-42-97.7-65.1-157-65.1-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L96 544l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157m-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1s56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6m101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8s-14.3 18-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7s-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2s-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4s4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6"
            fill="currentColor"></path></svg
        >
        Cotizar</ButtonPrimary
      >
      <!-- mobile menu -->
      <button
        type="button"
        class="md:hidden flex flex-col items-center gap-2 group cursor-pointer"
        id="burger-menu"
        aria-label="Abrir Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span
          class="bg-(--primary) w-8 h-0.5 translate-y-0 group-[.is-open]:rotate-45 group-[.is-open]:translate-y-2 transition-all duration-300 ease-in-out"
        ></span>
        <span
          class="bg-(--primary) w-8 h-0.5 opacity-100 group-[.is-open]:opacity-0 transition-all duration-300 ease-in-out"
        ></span>
        <span
          class="bg-(--primary) w-8 h-0.5 translate-y-0 group-[.is-open]:-rotate-45 group-[.is-open]:-translate-y-3 transition-all duration-300 ease-in-out"
        ></span>
      </button>
    </div>
  </nav>
</header>

<nav
  class="hidden [&.is-open]:flex fixed bg-white top-18 inset-0 z-50"
  id="mobile-menu"
  aria-label="Navegación Móvil"
  aria-hidden="true"
>
  <ul class="flex flex-col items-start gap-3 p-4 w-full">
    <li class="border-b border-gray-300 pb-4 w-full">
      <a
        href="#proyectos"
        class="text-(--text-primary) text-3xl font-bold hover:text-(--secondary) transition-all duration-300 ease-in-out"
        >Proyectos</a
      >
    </li>
    <li class="border-b border-gray-300 pb-4 w-full">
      <a
        href="#nosotros"
        class="text-(--text-primary) text-3xl font-bold hover:text-(--secondary) transition-all duration-300 ease-in-out"
        >Por qué nosotros</a
      >
    </li>
    <li class="border-b border-gray-300 pb-4 w-full">
      <a
        href="#contacto"
        class="text-(--text-primary) text-3xl font-bold hover:text-(--secondary) transition-all duration-300 ease-in-out"
        >Contacto y Preguntas</a
      >
    </li>
  </ul>
</nav>

<script>
  const burgerMenu = document.getElementById("burger-menu");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = mobileMenu?.querySelectorAll("a");

  const toggleMenu = (open: boolean) => {
    burgerMenu?.classList.toggle("is-open", open);
    mobileMenu?.classList.toggle("is-open", open);
    document.body.classList.toggle("overflow-hidden", open);

    burgerMenu?.setAttribute("aria-expanded", open.toString());
    burgerMenu?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };

  burgerMenu?.addEventListener("click", () => {
    const isOpen = burgerMenu.classList.contains("is-open");
    toggleMenu(!isOpen);
  });

  mobileLinks?.forEach((link) => {
    link.addEventListener("click", () => {
      toggleMenu(false);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      toggleMenu(false);
    }
  });
</script>
